# Entorno común. Copiar a .env.local o configurar las variables en el entorno.
NODE_ENV=development

# API
API_PORT=4000
API_HOST=0.0.0.0
DATABASE_URL=postgresql://geedyx:geedyx@localhost:5432/geedyx?schema=public
SHADOW_DATABASE_URL=postgresql://geedyx:geedyx@localhost:5432/geedyx_shadow?schema=public
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
COOKIE_SECURE=false
SESSION_COOKIE_NAME=geedyx_session

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Protección explícita para el comando destructivo db:reset.
GEEDYX_CONFIRM_DB_RESET=
