# Backend (NestJS) environment variables.
# Copy this file to .env for local development. Values documented as planned are
# intentionally not read by the current prototype code.

PORT=3001

# --- PostgreSQL ---
# Values below match docker-compose.yml.
DATABASE_URL=postgresql://geedyx:change-me@localhost:5432/geedyx?schema=public
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=geedyx
POSTGRES_USER=geedyx
POSTGRES_PASSWORD=change-me

# --- Prototype image uploads (currently used) ---
# Relative paths resolve from apps/api/ during local development.
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=5

# --- Browser authentication ---
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY=false
OPENAPI_ENABLED=true

SESSION_IDLE_TTL=30m
SESSION_ABSOLUTE_TTL=12h
SESSION_MAX_PER_USER=5
REAUTHENTICATION_TTL=10m
PASSWORD_RESET_TTL=30m
PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW=1m
# Required in production. Receives recipient, resetUrl and expiresAt as JSON.
# PASSWORD_RESET_DELIVERY_ENDPOINT=https://notifications.example/reset-password
# PASSWORD_RESET_DELIVERY_TOKEN=replace-with-a-provider-secret
# S3-compatible production file provider configuration.
# FILE_STORAGE_PROVIDER=local
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
