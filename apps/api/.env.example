# Backend (NestJS) environment variables.
# Copy this file to .env for local development. Values documented as planned are
# intentionally not read by the current prototype code.

PORT=3001

# --- PostgreSQL ---
# Values below match docker-compose.yml.
DATABASE_URL=postgresql://geedyx:change-me@localhost:5432/geedyx?schema=public
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=geedyx
POSTGRES_USER=geedyx
POSTGRES_PASSWORD=change-me

# --- Prototype image uploads (currently used) ---
# Relative paths resolve from apps/api/ during local development.
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=5

# --- Prototype authentication (currently used; replaced in Phase 1) ---
# This secret is required and must never be exposed to the frontend.
JWT_SECRET=
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY=false
OPENAPI_ENABLED=true

# --- Phase 1 configuration (planned; do not set secrets in source control) ---
# Installation secret required to create the first company owner.
# INSTALLATION_SECRET=
# Opaque-session idle and absolute lifetimes.
# SESSION_IDLE_TTL=30m
# SESSION_ABSOLUTE_TTL=12h
# S3-compatible production file provider configuration.
# FILE_STORAGE_PROVIDER=local
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
