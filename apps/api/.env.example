# Backend (NestJS) environment variables.
#
# Copy this file to .env and adjust values for local development.
# These variables are backend secrets and must NEVER be exposed to the
# frontend. Do not prefix anything here with NEXT_PUBLIC_.

# Port the API listens on.
PORT=3001

# --- PostgreSQL ---
# Connection used by Prisma (CLI via prisma.config.ts and runtime via the
# PrismaPg driver adapter). Values below match the local docker-compose setup.
DATABASE_URL=postgresql://geedyx:change-me@localhost:5432/geedyx?schema=public

# Values used by the docker-compose PostgreSQL service.
# Adjust only if the docker-compose.yml configuration changes.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=geedyx
POSTGRES_USER=geedyx
POSTGRES_PASSWORD=change-me

# --- Image uploads (product images) ---
# Directory where product images are stored on the local filesystem.
# Relative paths resolve from the API process working directory; for local
# development that is apps/api/uploads/ (gitignored). Created on demand.
UPLOAD_DIR=uploads
# Maximum size of an uploaded product image in MB (default 5).
MAX_IMAGE_SIZE_MB=5

# --- Future variables (documented, not used yet) ---
# JSON Web Token refresh secret.
# JWT_REFRESH_SECRET=
# Public base URL of the API (used for cookies in future auth).
# API_URL=http://localhost:3001

# --- Authentication (used by auth module) ---
# JSON Web Token signing secret (required). The API refuses to start when this
# is missing or empty. Generate a strong random value for production
# (e.g. `openssl rand -hex 32`) and never expose it to the frontend.
JWT_SECRET=
# JWT/session lifetime in s, m, h, d units (default 1h).
JWT_EXPIRES_IN=1h
# Allowed frontend origin(s), comma-separated. CORS credentials are only sent
# from these origins. In production set this to the real frontend origin.
CORS_ORIGINS=http://localhost:3000
# Set to true when the API is served over HTTPS so the auth cookie is Secure.
COOKIE_SECURE=false
# Set to true when the API runs behind a reverse proxy. The proxy then
# provides the real client IP (X-Forwarded-For) used by rate limiting.
# Defaults to false; keep false when clients reach the API directly.
TRUST_PROXY=false