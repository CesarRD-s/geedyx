# Backend (NestJS) environment variables.
# Copy this file to .env for local development. Keep real deployment secrets
# outside Git.

PORT=3001

# --- PostgreSQL ---
# Values below match docker-compose.yml.
DATABASE_URL=postgresql://geedyx:change-me@localhost:5432/geedyx?schema=public
# Isolated database used only by `pnpm test:e2e`; never point this at development.
E2E_DATABASE_URL=postgresql://geedyx:change-me@localhost:5432/geedyx_e2e?schema=public
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=geedyx
POSTGRES_USER=geedyx
POSTGRES_PASSWORD=change-me

# --- Private file storage ---
# Local storage is suitable only for development and test. It is never served
# as a public static directory.
FILE_STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=5
FILE_URL_TTL=10m
# Required in production, minimum 32 random characters. Keep it outside Git.
# FILE_URL_SIGNING_SECRET=

# --- Browser authentication ---
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY=false
OPENAPI_ENABLED=true

SESSION_IDLE_TTL=30m
SESSION_ABSOLUTE_TTL=12h
SESSION_MAX_PER_USER=5
REAUTHENTICATION_TTL=10m
PASSWORD_RESET_TTL=30m
PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password
INVITATION_TTL=7d
INVITATION_URL_BASE=http://localhost:3000/accept-invitation
EMAIL_CHANGE_TTL=30m
EMAIL_CHANGE_URL_BASE=http://localhost:3000/confirm-email-change
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW=1m
# Transactional email. Local development suppresses delivery by default.
EMAIL_PROVIDER=disabled
EMAIL_DELIVERY_MAX_ATTEMPTS=2
# Required in production when EMAIL_PROVIDER=resend. Use a verified Resend domain.
# RESEND_API_KEY=re_replace-with-a-provider-secret
# EMAIL_FROM=GEEDYX <security@example.com>
# Required in production before enabling webhook endpoints. Generate 32 random bytes and encode as Base64.
# WEBHOOK_ENCRYPTION_KEY=
# Supabase Storage accepts the S3-compatible API. Use its S3 endpoint, bucket
# and access credentials. Do not configure FILE_STORAGE_PROVIDER=s3 until all
# values below are available.
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
