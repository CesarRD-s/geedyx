// Prisma schema
//
// provider:  postgresql
// connection: configured in prisma.config.ts (DATABASE_URL env var)

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// The single internal company configured during installation.
model Company {
  id           String         @id @default(cuid())
  name         String
  users        User[]
  installation Installation?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

/// Immutable singleton that records the completed installation.
/// Its existence prevents the bootstrap endpoint from reopening.
model Installation {
  id          String   @id @default("singleton")
  installedAt DateTime @default(now())
  companyId   String   @unique
  ownerId     String   @unique
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  owner       User     @relation("InstallationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
}

/// Internal user identity. Future users belong to the company created during
/// installation.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  installation Installation? @relation("InstallationOwner")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
}

/// Product categories. A category can contain many products.
model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

/// A product in the catalog. Belongs to exactly one category.
/// price is a PostgreSQL numeric to avoid floating-point money.
model Product {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  sku               String   @unique
  description       String?
  price             Decimal  @db.Decimal(10, 2)
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  imageUrl          String?
  isActive          Boolean  @default(true)
  categoryId        String
  category          Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([categoryId])
}
